<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS ARR Reverse Proxy — Dealer Platform QA Dashboard
  =====================================================
  Place this web.config in the IIS site root for the dashboard.

  Setup (one-time in IIS Manager):
    1. Open IIS Manager
    2. Add a new Site:
         Site name    : dealer-qa-dashboard
         Physical path: <repo>\QAAutomationDealerPlatform\dashboard\iis
         Port         : 3333   (or bind to host header — see option B below)
    3. Enable ARR proxy:
         Server level → Application Request Routing → Server Proxy Settings
         → Enable proxy ✓ → Apply

  Access options:
    Option A — Port binding:   http://<server-ip>:3333/
    Option B — Host header:    https://qa-dashboard.yourdomain.com/
                               (add DNS A record → server IP, bind in IIS)
    Option C — Sub-path via    existing site's ARR rule (see bottom of file)
               existing site:  https://demoportal-test.channel-fusion.com/dealer-qa/
-->
<configuration>
  <system.webServer>

    <!-- Reverse proxy all requests to the Node.js dashboard server -->
    <rewrite>
      <rules>
        <rule name="DealerQADashboardProxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="localhost" negate="true" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3333/{R:1}" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR"   value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_HOST"  value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>
    </rewrite>

    <!-- Allow proxy passthrough -->
    <proxy enabled="true" preserveHostHeader="false" reverseRewriteHostInResponseHeaders="true" />

    <!-- SSE requires response buffering OFF — critical for live log streaming -->
    <httpCompression>
      <dynamicTypes>
        <remove mimeType="text/event-stream" />
        <add mimeType="text/event-stream" enabled="false" />
      </dynamicTypes>
    </httpCompression>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
