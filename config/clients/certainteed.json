{
  "clientId":    "certainteed",
  "clientName":  "CertainTeed",
  "clientType":  "legacy-shared",
  "platform":    "demoportal",
  "stub":        true,

  "authentication": {
    "type":      "forms",
    "loginPath": "/Account/Login?Internal",
    "usernameSelector": "#UserLogin_Username",
    "passwordSelector": "#UserLogin_Password",
    "submitSelector":   "#btnLogin"
  },

  "modules": ["coop", "engage-ads", "popshop", "rebate"],

  "repository": {
    "_comment": "Populate localPath in config/repos.local.json",
    "type":        "git",
    "branch":      "main",
    "localPathKey": "certainteed"
  },

  "environments": {
    "production": {
      "label": "Production",
      "baseUrl": "https://certainteedportal.channel-fusion.com/account/login?Internal",
      "apiUrl": "https://certainteedportal.channel-fusion.com/account/login?Internal",
      "envFile": "production"
    },
    "uat": {
      "label": "UAT",
      "baseUrl": "https://certainteedportaluat.channel-fusion.com/account/login?Internal",
      "apiUrl": "https://certainteedportaluat.channel-fusion.com/account/login?Internal",
      "envFile": "uat"
    }
  },
  "roles": ["dealer", "admin"],
  "defaultEnvironment": "uat",
  "loginPath": "/Account/Login?Internal",
  "featureFlags": {
    "engageAds": true,
    "coop": true,
    "popshop": true,
    "rebate": true
  }
}
