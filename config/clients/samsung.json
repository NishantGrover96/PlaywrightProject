{
    "clientId":  "samsung",
    "clientName":  "Samsung HVAC",
    "clientType":  "legacy-shared",
    "platform":  "demoportal",
    "stub":  true,
    "authentication":  {
                           "type":  "forms",
                           "loginPath":  "/Account/Login",
                           "usernameSelector":  "#UserLogin_Username",
                           "passwordSelector":  "#UserLogin_Password",
                           "submitSelector":  "#btnLogin"
                       },
    "modules":  [
                    "coop",
                    "incentive",
                    "spiff"
                ],
    "repository":  {
                       "_comment":  "Populate localPath in config/repos.local.json",
                       "type":  "git",
                       "branch":  "main",
                       "localPathKey":  "samsung"
                   },
    "environments":  {
                         "production":  {
                                            "label":  "Production",
                                            "baseUrl":  "https://portal.samsunghvac.com",
                                            "apiUrl":  "https://portal.samsunghvac.com",
                                            "envFile":  "production"
                                        },
                         "uat":  {
                                     "label":  "UAT",
                                     "baseUrl":  "https://samsungportaluat.channel-fusion.com",
                                     "apiUrl":  "https://samsungportaluat.channel-fusion.com",
                                     "envFile":  "uat"
                                 },
                         "testing":  {
                                         "label":  "Testing",
                                         "baseUrl":  "https://samsungportaltest.channel-fusion.com",
                                         "apiUrl":  "https://samsungportaltest.channel-fusion.com",
                                         "envFile":  "testing"
                                     },
                         "dev":  {
                                     "label":  "Dev",
                                     "baseUrl":  "https://samsungportaldev.channel-fusion.com",
                                     "apiUrl":  "https://samsungportaldev.channel-fusion.com",
                                     "envFile":  "dev"
                                 }
                     },
    "roles":  [
                  "dealer",
                  "admin"
              ],
    "defaultEnvironment":  "uat",
    "featureFlags":  {
                         "engageAds":  false,
                         "coop":  true,
                         "popshop":  false,
                         "rebate":  false
                     }
}